@baseUrl = http://localhost:3000/api

# Ejecutar primero el login de auth.http y pegar el token aquí
@token = PEGAR_TOKEN_AQUI

### Listar todos los viajes
GET {{baseUrl}}/viajes
Authorization: Bearer {{token}}

### Filtrar viajes por vehículo
GET {{baseUrl}}/viajes?vehiculo_id=1
Authorization: Bearer {{token}}

### Filtrar viajes por conductor
GET {{baseUrl}}/viajes?conductor_id=1
Authorization: Bearer {{token}}

### Historial de viajes por vehículo (incluye total de kilómetros)
GET {{baseUrl}}/viajes/vehiculo/1/historial
Authorization: Bearer {{token}}

### Historial de viajes por conductor (incluye total de kilómetros)
GET {{baseUrl}}/viajes/conductor/1/historial
Authorization: Bearer {{token}}

### Resumen de kilómetros por vehículo
GET {{baseUrl}}/viajes/resumen/vehiculos
Authorization: Bearer {{token}}

### Resumen de kilómetros por conductor
GET {{baseUrl}}/viajes/resumen/conductores
Authorization: Bearer {{token}}

### Crear viaje
POST {{baseUrl}}/viajes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "vehiculo_id": 1,
  "conductor_id": 1,
  "fecha_de_salida": "2026-11-16T08:00:00",
  "fecha_de_llegada": "2026-11-16T18:30:00",
  "origen": "La Rioja",
  "destino": "Córdoba",
  "kilometros": 430.5,
  "observaciones": "Viaje con carga liviana"
}

### Actualizar viaje
PUT {{baseUrl}}/viajes/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "vehiculo_id": 1,
  "conductor_id": 1,
  "fecha_de_salida": "2026-11-16T08:00:00",
  "fecha_de_llegada": "2026-11-16T20:00:00",
  "origen": "La Rioja",
  "destino": "Córdoba",
  "kilometros": 435,
  "observaciones": "Se extendió el horario de llegada"
}

### Error de validación: kilómetros negativos (debe responder 400)
POST {{baseUrl}}/viajes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "vehiculo_id": 1,
  "conductor_id": 1,
  "fecha_de_salida": "2026-11-16T08:00:00",
  "fecha_de_llegada": "2026-11-16T18:30:00",
  "origen": "La Rioja",
  "destino": "Córdoba",
  "kilometros": -50
}

### Eliminar viaje
DELETE {{baseUrl}}/viajes/1
Authorization: Bearer {{token}}
