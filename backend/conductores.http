@baseUrl = http://localhost:3000/api

# Ejecutar primero el login de auth.http y pegar el token aquí
@token = PEGAR_TOKEN_AQUI

### Listar conductores
GET {{baseUrl}}/conductores
Authorization: Bearer {{token}}

### Obtener un conductor
GET {{baseUrl}}/conductores/1
Authorization: Bearer {{token}}

### Crear conductor
POST {{baseUrl}}/conductores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Juan",
  "apellido": "Pérez",
  "numero_de_documento": "30123456",
  "numero_de_licencia": "LIC-2026-001",
  "fecha_de_alta_de_licencia": "2024-01-15",
  "fecha_de_vencimiento_de_licencia": "2029-01-15"
}

### Actualizar conductor
PUT {{baseUrl}}/conductores/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Juan Carlos",
  "apellido": "Pérez",
  "numero_de_documento": "30123456",
  "numero_de_licencia": "LIC-2026-001",
  "fecha_de_alta_de_licencia": "2024-01-15",
  "fecha_de_vencimiento_de_licencia": "2030-01-15"
}

### Error de validación: nombre con números y DNI con letras (debe responder 400)
POST {{baseUrl}}/conductores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Juan123",
  "apellido": "Pérez",
  "numero_de_documento": "30ABC456",
  "numero_de_licencia": "LIC-2026-002",
  "fecha_de_alta_de_licencia": "2024-01-15",
  "fecha_de_vencimiento_de_licencia": "2029-01-15"
}

### Eliminar conductor
DELETE {{baseUrl}}/conductores/1
Authorization: Bearer {{token}}
